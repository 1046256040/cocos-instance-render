      "glsl1": {
        "vert": "\nprecision highp float;\nuniform mat4 cc_matViewProj;\nuniform mat4 cc_matWorld;\nattribute vec3 a_position;\nattribute vec2 a_uv0;\n#if USE_INSTANCING\n  attribute vec4 a_instanced_transform;\n  attribute vec4 a_instanced_color;\n  attribute vec4 a_instanced_glyph;\n#endif\nuniform vec4 glyphGrid;\nuniform vec4 glyphUvControl;\nvarying vec2 v_uv0;\nvarying vec4 v_color;\nvarying float v_alpha;\nvec4 vert () {\n  vec2 localPosition = a_position.xy;\n  float glyphIndex = 0.0;\n  vec4 glyphColor = vec4(1.0);\n  float glyphAlpha = 1.0;\n  float glyphScale = 1.0;\n  vec2 glyphOffset = vec2(0.0);\n  #if USE_INSTANCING\n    glyphOffset = a_instanced_transform.xy;\n    glyphScale = a_instanced_transform.z;\n    glyphIndex = a_instanced_glyph.x;\n    glyphAlpha = a_instanced_glyph.y;\n    glyphColor = a_instanced_color;\n  #endif\n  float cols = glyphGrid.x;\n  float rows = glyphGrid.y;\n  float cellWidth = glyphGrid.z;\n  float cellHeight = glyphGrid.w;\n  float col = mod(glyphIndex, cols);\n  float logicalRow = floor(glyphIndex / cols);\n  float row = mix(logicalRow, rows - 1.0 - logicalRow, glyphUvControl.x);\n  vec2 uv = a_uv0;\n  uv.y = mix(uv.y, 1.0 - uv.y, glyphUvControl.y);\n  uv.x = uv.x * cellWidth + col * cellWidth;\n  uv.y = uv.y * cellHeight + row * cellHeight;\n  v_uv0 = uv;\n  v_color = glyphColor;\n  v_alpha = glyphAlpha;\n  vec3 position = vec3(localPosition * glyphScale + glyphOffset, a_position.z);\n  return cc_matViewProj * cc_matWorld * vec4(position, 1.0);\n}\nvoid main() { gl_Position = vert(); }",
        "frag": "\nprecision highp float;\n#if USE_ALPHA_TEST\n  uniform float alphaThreshold;\n#endif\nvoid ALPHA_TEST (in vec4 color) {\n  #if USE_ALPHA_TEST\n      if (color.a < alphaThreshold) discard;\n  #endif\n}\nvoid ALPHA_TEST (in float alpha) {\n  #if USE_ALPHA_TEST\n      if (alpha < alphaThreshold) discard;\n  #endif\n}\nvec4 CCFragOutput (vec4 color) {\n  #if OUTPUT_TO_GAMMA\n    color.rgb = sqrt(color.rgb);\n  #endif\n\treturn color;\n}\nuniform sampler2D mainTexture;\nuniform float alphaThreshold;\nvarying vec2 v_uv0;\nvarying vec4 v_color;\nvarying float v_alpha;\nvec4 frag () {\n  vec4 color = texture2D(mainTexture, v_uv0) * v_color;\n  color.a *= v_alpha;\n  ALPHA_TEST(color);\n  return CCFragOutput(color);\n}\nvoid main() { gl_FragColor = frag(); }"
      },
      "glsl3": {
        "vert": "\nprecision highp float;\nuniform CCGlobal {\n  mat4 cc_matView;\n  mat4 cc_matViewInv;\n  mat4 cc_matProj;\n  mat4 cc_matProjInv;\n  mat4 cc_matViewProj;\n  mat4 cc_matViewProjInv;\n  vec4 cc_cameraPos;\n  vec4 cc_time;\n  mediump vec4 cc_screenSize;\n  mediump vec4 cc_screenScale;\n};\nuniform CCLocal {\n  mat4 cc_matWorld;\n  mat4 cc_matWorldIT;\n};\nin vec3 a_position;\nin vec2 a_uv0;\n#if USE_INSTANCING\n  in vec4 a_instanced_transform;\n  in vec4 a_instanced_color;\n  in vec4 a_instanced_glyph;\n#endif\nuniform Constant {\n  vec4 glyphGrid;\n  vec4 glyphUvControl;\n  float alphaThreshold;\n};\nout vec2 v_uv0;\nout vec4 v_color;\nout float v_alpha;\nvec4 vert () {\n  vec2 localPosition = a_position.xy;\n  float glyphIndex = 0.0;\n  vec4 glyphColor = vec4(1.0);\n  float glyphAlpha = 1.0;\n  float glyphScale = 1.0;\n  vec2 glyphOffset = vec2(0.0);\n  #if USE_INSTANCING\n    glyphOffset = a_instanced_transform.xy;\n    glyphScale = a_instanced_transform.z;\n    glyphIndex = a_instanced_glyph.x;\n    glyphAlpha = a_instanced_glyph.y;\n    glyphColor = a_instanced_color;\n  #endif\n  float cols = glyphGrid.x;\n  float rows = glyphGrid.y;\n  float cellWidth = glyphGrid.z;\n  float cellHeight = glyphGrid.w;\n  float col = mod(glyphIndex, cols);\n  float logicalRow = floor(glyphIndex / cols);\n  float row = mix(logicalRow, rows - 1.0 - logicalRow, glyphUvControl.x);\n  vec2 uv = a_uv0;\n  uv.y = mix(uv.y, 1.0 - uv.y, glyphUvControl.y);\n  uv.x = uv.x * cellWidth + col * cellWidth;\n  uv.y = uv.y * cellHeight + row * cellHeight;\n  v_uv0 = uv;\n  v_color = glyphColor;\n  v_alpha = glyphAlpha;\n  vec3 position = vec3(localPosition * glyphScale + glyphOffset, a_position.z);\n  return cc_matViewProj * cc_matWorld * vec4(position, 1.0);\n}\nvoid main() { gl_Position = vert(); }",
        "frag": "\nprecision highp float;\n#if USE_ALPHA_TEST\n  uniform ALPHA_TEST {\n    float alphaThreshold;\n  };\n#endif\nvoid ALPHA_TEST (in vec4 color) {\n  #if USE_ALPHA_TEST\n      if (color.a < alphaThreshold) discard;\n  #endif\n}\nvoid ALPHA_TEST (in float alpha) {\n  #if USE_ALPHA_TEST\n      if (alpha < alphaThreshold) discard;\n  #endif\n}\nvec4 CCFragOutput (vec4 color) {\n  #if OUTPUT_TO_GAMMA\n    color.rgb = sqrt(color.rgb);\n  #endif\n\treturn color;\n}\nuniform sampler2D mainTexture;\nuniform Constant {\n  vec4 glyphGrid;\n  vec4 glyphUvControl;\n  float alphaThreshold;\n};\nin vec2 v_uv0;\nin vec4 v_color;\nin float v_alpha;\nvec4 frag () {\n  vec4 color = texture(mainTexture, v_uv0) * v_color;\n  color.a *= v_alpha;\n  ALPHA_TEST(color);\n  return CCFragOutput(color);\n}\nout vec4 cc_FragColor;\nvoid main() { cc_FragColor = frag(); }"
